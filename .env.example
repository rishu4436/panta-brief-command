# Required — server-side only (injected by /api/panta/* as X-Api-Key)
PANTA_API_KEY=pk_test_your_key_here

# Panta API base (trailing slash optional; proxy normalizes)
PANTA_API_BASE_URL=https://live-api.panta.market/api/v1

# Solana mainnet RPC — SERVER ONLY. The browser calls /api/rpc, which relays to
# this URL (key included), so the key never reaches the client bundle or CSP.
# Use a dedicated provider (Helius, QuickNode, Triton, Alchemy). Required in
# production: unset => /api/rpc returns 503 RPC_NOT_CONFIGURED (no public fallback).
SOLANA_RPC_URL=

# Local dev only: relay upstream when SOLANA_RPC_URL is unset and NODE_ENV is not
# production. Never read by the browser; do not set in production.
# NEXT_PUBLIC_DEFAULT_RPC=https://api.mainnet-beta.solana.com

# Optional — richer AI Brief (templated narrative if unset). The same key and
# model power the AI Debate Arena in Prediction Rooms (docs/DEBATE_ARENA.md);
# unset = the arena shows "AI unavailable" and generates nothing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional — web search for debate evidence. No provider ships enabled; leave
# empty (or "none") and debates cite only Panta, on-chain and declared sources.
DEBATE_SEARCH_PROVIDER=

# Shared rate limit, brief cache and feedback/usage evidence across instances
# (Upstash Redis REST). Required in production for shared persistence; unset =
# per-instance memory + temporary disk, reported as such (X-Store-Status header,
# feedback response, /api/admin/export?kind=diagnostics). Each call is capped at
# 700 ms with no retries, then falls back. KV_REST_API_URL / KV_REST_API_TOKEN also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Off Vercel (local `next dev` / `next start`) the two vars above are IGNORED unless
# ROOMS_ALLOW_LOCAL_REDIS=1, so a machine that exports production credentials can't
# touch production keys by accident. Set it only for a dedicated dev/self-hosted DB.
ROOMS_ALLOW_LOCAL_REDIS=

# Optional — early-user evidence export (GET /api/admin/export, Bearer token, >= 24 chars).
ADMIN_EXPORT_SECRET=
# Optional — JSON-lines evidence log directory when no shared store is set.
EVIDENCE_LOG_DIR=

# Prediction Rooms (docs/PREDICTION_ROOMS.md)
# Durable room storage in production = the Upstash vars above (required on
# Vercel; without them room reads answer 503 and creation fails closed).
# Session signing secret for wallet sign-in, at least 32 random characters.
# Required in production (sign-in fails closed without it); dev uses a
# random per-process secret.
ROOMS_SESSION_SECRET=
# Optional, self-hosted / local `next start` only (never used on Vercel):
# path of the SQLite file. Dev defaults to .data/rooms.sqlite.
ROOMS_SQLITE_PATH=
# Forecasting Arena (docs/ARENA.md): server-only admin token for
# POST /api/arena/finalize and `npm run arena:finalize`. At least 32 random
# characters (e.g. `openssl rand -hex 32`). Unset/short = finalization
# disabled (503). Never expose it as NEXT_PUBLIC_*.
ROOMS_ADMIN_TOKEN=
# Canonical public origin for embed snippets, share links and room metadata
# (docs/EMBEDS.md). https only in production, no path. Never derived from the
# request Host header. Unset: production uses https://briefcommand.vercel.app,
# development http://localhost:3100. NEXT_PUBLIC_APP_ORIGIN is also read.
APP_ORIGIN=
