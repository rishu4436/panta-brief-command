# Required — server-side only (injected by /api/panta/* as X-Api-Key)
PANTA_API_KEY=pk_test_your_key_here

# Panta API base (trailing slash optional; proxy normalizes)
PANTA_API_BASE_URL=https://live-api.panta.market/api/v1

# Solana mainnet RPC for the wallet connection (balances, blockhash, confirm).
# Recommended: a dedicated RPC URL from Helius, QuickNode, Triton or Alchemy.
# The public endpoint below is only a fallback: it is heavily rate-limited, and
# dev builds log a console note when it is in use.
NEXT_PUBLIC_DEFAULT_RPC=https://api.mainnet-beta.solana.com

# Optional — richer AI Brief (templated narrative if unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
